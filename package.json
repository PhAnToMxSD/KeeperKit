{
  "name": "keeperkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "KeeperKit — Native SDK + ElizaOS Plugin for KeeperHub",
  "scripts": {
    "build": "pnpm -r build",
    "build:sdk": "pnpm --filter keeperkit build",
    "build:plugin": "pnpm --filter @keeperhub/plugin-keeperkit build",
    "chat": "cd frontend && bun run start",
    "test": "pnpm -r test",
    "test:sdk": "pnpm --filter keeperkit test",
    "test:plugin": "pnpm --filter @keeperhub/plugin-keeperkit test",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
